generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}


model User {
  id        String   @id
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenses       Expense[]    @relation("ExpenseCreator")
  people         Person[]     @relation("PersonCreator")
  categories     Category[]   @relation("CategoryCreator")
}

model Person {
  id           String   @id @default(cuid())
  name         String
  lastName     String?
  avatarUrl    String?
  identifier   String?
  userId       String
  linkedUserId String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user      User     @relation("PersonCreator", fields: [userId], references: [id], onDelete: Cascade)
  paidExpenses     Expense[]          @relation("ExpensePayer")
  participations  ExpenseParticipant[]
  debtsAsDebtor   Debt[]              @relation("DebtDebtor")
  debtsAsCreditor Debt[]              @relation("DebtCreditor")

  @@index([userId])
}

model Category {
  id        String   @id @default(cuid())
  name      String
  color     String?
  icon      String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenses Expense[]
  user     User     @relation("CategoryCreator", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Expense {
  id             String        @id @default(cuid())
  title          String
  description    String?
  amount         Decimal
  date           DateTime
  type           String        @default("EXPENSE")
  splitType      String        @default("PERCENTAGE")
  categoryId     String?
  payerId        String
  createdById    String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  category       Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  payer          Person        @relation("ExpensePayer", fields: [payerId], references: [id], onDelete: Restrict)
  createdBy      User          @relation("ExpenseCreator", fields: [createdById], references: [id], onDelete: Restrict)
  participants   ExpenseParticipant[]
  attachments    Attachment[]

  @@index([payerId])
  @@index([createdById])
  @@index([categoryId])
  @@index([date])
}

model ExpenseParticipant {
  id          String   @id @default(cuid())
  expenseId   String
  personId    String
  percentage  Decimal?
  amount      Decimal?
  share       Decimal
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  expense     Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  person      Person   @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([expenseId, personId])
  @@index([expenseId])
  @@index([personId])
}

model Attachment {
  id          String   @id @default(cuid())
  expenseId   String
  filename    String
  originalName String
  mimeType    String
  path        String
  size        Int
  type        String   @default("file")
  createdAt   DateTime @default(now())

  expense     Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([expenseId])
}

model Debt {
  id          String   @id @default(cuid())
  debtorId    String
  creditorId  String
  amount      Decimal
  settled     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  debtor      Person   @relation("DebtDebtor", fields: [debtorId], references: [id], onDelete: Cascade)
  creditor    Person   @relation("DebtCreditor", fields: [creditorId], references: [id], onDelete: Cascade)

  @@index([debtorId, creditorId])
  @@index([settled])
}
